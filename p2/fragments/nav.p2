{% comment %}
  Navigation fragment.

  This template renders only the inside of the navbar its parent already opened,
  because Bulma's menu is a container the parent controls: the brand and the
  mobile toggle belong to the navbar, while what is below them belongs to
  whoever is navigating. A fragment that emitted its own <nav> would nest one
  navigation inside another, which is what the default theme's markup does and
  what Bulma's CSS has no rule for.

  The items arrive already filtered: deciding whether a viewer may see a link
  belongs to the authorization layer, and a template that re-implemented it here
  would be a second answer to "what is TASKS:ADMIN", one that disagrees with
  the first as soon as the rules grow a case, and disagrees in the direction of
  showing a link the route behind it then refuses.

  The active item comes from pageBase, which the framework derives from the
  request path, so a page cannot highlight the wrong thing by forgetting to say
  where it is.
{% endcomment %}
<div class="navbar-start">
  {% for item in navElements %}
  {% if item.Children %}
  <div class="navbar-item has-dropdown is-hoverable">
    <span class="navbar-link{% if item.Base == pageBase %} is-active{% endif %}">{{ item.Label }}</span>
    <div class="navbar-dropdown">
      {% for child in item.Children %}
      <a class="navbar-item" href="{{ child.Href }}">{{ child.Label }}</a>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <a class="navbar-item{% if item.Base == pageBase %} is-active{% endif %}"
     href="{{ item.Href }}"{% if item.Base == pageBase %} aria-current="page"{% endif %}>
    {%- if item.Icon %}<span class="icon is-small" aria-hidden="true">{{ item.Icon }}</span> {% endif -%}
    {{ item.Label }}
  </a>
  {% endif %}
  {% empty %}
  <span class="navbar-item is-inline-tablet has-text-grey">No sections available</span>
  {% endfor %}
</div>

<div class="navbar-end">
  {% comment %}
    The light/dark switch. Its checkbox is the single source of truth for the
    color scheme: theme.js reads it, mirrors it into data-theme on <html>, and
    persists it, so the markup carries no handler of its own and an application
    under Content-Security-Policy: script-src 'self' keeps a working toggle.
  {% endcomment %}
  <div class="navbar-item">
    <label class="switch" for="wa-theme-toggle" title="Toggle dark mode">
      <input type="checkbox" id="wa-theme-toggle">
      <span class="switch-track"><span class="switch-thumb"></span></span>
      <span class="switch-icon" aria-hidden="true">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
          <circle cx="32.003" cy="32.005" r="16.001"/>
          <path d="M12.001,31.997c0-2.211-1.789-4-4-4H4c-2.211,0-4,1.789-4,4 s1.789,4,4,4h4C10.212,35.997,12.001,34.208,12.001,31.997z"/>
          <path d="M12.204,46.139l-2.832,2.833c-1.563,1.562-1.563,4.094,0,5.656 c1.562,1.562,4.094,1.562,5.657,0l2.833-2.832c1.562-1.562,1.562-4.095,0-5.657C16.298,44.576,13.767,44.576,12.204,46.139z"/>
          <path d="M32.003,51.999c-2.211,0-4,1.789-4,4V60c0,2.211,1.789,4,4,4 s4-1.789,4-4l-0.004-4.001C36.003,53.788,34.21,51.999,32.003,51.999z"/>
          <path d="M51.798,46.143c-1.559-1.566-4.091-1.566-5.653-0.004 s-1.562,4.095,0,5.657l2.829,2.828c1.562,1.57,4.094,1.562,5.656,0s1.566-4.09,0-5.656L51.798,46.143z"/>
          <path d="M60.006,27.997l-4.009,0.008 c-2.203-0.008-3.992,1.781-3.992,3.992c-0.008,2.211,1.789,4,3.992,4h4.001c2.219,0.008,4-1.789,4-4 C64.002,29.79,62.217,27.997,60.006,27.997z"/>
          <path d="M51.798,17.859l2.828-2.829c1.574-1.566,1.562-4.094,0-5.657 c-1.559-1.567-4.09-1.567-5.652-0.004l-2.829,2.836c-1.562,1.555-1.562,4.086,0,5.649C47.699,19.426,50.239,19.418,51.798,17.859z"/>
          <path d="M32.003,11.995c2.207,0.016,4-1.789,4-3.992v-4 c0-2.219-1.789-4-4-4c-2.211-0.008-4,1.781-4,3.993l0.008,4.008C28.003,10.206,29.792,11.995,32.003,11.995z"/>
          <path d="M12.212,17.855c1.555,1.562,4.079,1.562,5.646-0.004 c1.574-1.551,1.566-4.09,0.008-5.649l-2.829-2.828c-1.57-1.571-4.094-1.559-5.657,0c-1.575,1.559-1.575,4.09-0.012,5.653 L12.212,17.855z"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
        </svg>
      </span>
    </label>
  </div>
  {% if isAuthenticated %}
  <div class="navbar-item">
    <form method="post" action="{{ signOutURL|default:'/logout' }}">
      {{ csrfInput }}
      <button type="submit" class="button is-small">Sign out {{ user.Identity }}</button>
    </form>
  </div>
  {% else %}
  <div class="navbar-item">
    <a class="button is-small" href="{{ signInURL|default:'/login' }}">Sign in</a>
  </div>
  {% endif %}
</div>
